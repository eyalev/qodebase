// qodebase fleet on Workers AI (sim/fleet/src/index.js). Forq's account, its own Artifacts namespace `qbfleet`.
//   CLOUDFLARE_API_TOKEN=$(cat ~/.config/forq-cf/api-token) npx wrangler deploy -c sim/fleet/wrangler.jsonc
// Secrets: FLEET_KEY (~/.config/qbfleet/key), PUSHOVER_TOKEN, PUSHOVER_USER, GEMINI_KEY (~/.config/qodebase-fleet/gemini.key).
{
  "name": "qbfleet",
  "account_id": "887d7234a6b8d65ad355a4f6684cab67",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // typescript.js reads __filename/__dirname at load (Workers have neither)
  "define": { "__filename": "\"/typescript.js\"", "__dirname": "\"/\"" },
  "ai": { "binding": "AI" },
  // S3: the answers the fleet already produced, keyed by the original file's blob hash (scripts/build-cache.mjs)
  "kv_namespaces": [{ "binding": "FLEET_CACHE", "id": "fcaf78997dea45c6b8d145598f878dfe" }],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "qbfleet" }, { "binding": "ARTIFACTS2", "namespace": "qbfleet2" }],
  "vars": {
    "FLEET_LAST_DAY": "2026-10-14",
    // [input, output] $ per million tokens; set from qb4's F0 before a run (an unpriced model is refused)
    // listed per-token prices from the account's model catalogue (ai/models/search), 2026-10-13
    "FLEET_PRICES": "{\"@cf/zai-org/glm-4.7-flash\":[0.0605,0.4],\"@cf/google/gemma-4-26b-a4b-it\":[0.1,0.3],\"@cf/qwen/qwen3-30b-a3b-fp8\":[0.0509,0.335],\"@cf/openai/gpt-oss-20b\":[0.2,0.3],\"@cf/zai-org/glm-5.3-flash\":[0.15,0.5],\"@cf/openai/gpt-oss-120b\":[0.35,0.75],\"@cf/meta/llama-4-scout-17b-16e-instruct\":[0.27,0.85],\"gemini-3.5-flash-lite\":[0.3,2.5],\"gemini-2.5-flash-lite\":[0.1,0.4],\"gemini-3.1-flash-lite\":[0.25,1.5]}"
  },
  "durable_objects": {
    "bindings": [
      { "name": "RUN", "class_name": "Run" },
      { "name": "AGENT", "class_name": "Agent" },
      { "name": "LANDER", "class_name": "Lander" },
      { "name": "BUDGET", "class_name": "Budget" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Run", "Agent", "Lander", "Budget"] }]
}
