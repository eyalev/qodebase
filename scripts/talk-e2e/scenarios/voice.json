[
 {
  "id": "voice-build-start",
  "title": "Build by voice end to end: idea, cheapest, 'yes, build it' -> brief asks with the estimate, 'call it \u2026', 'yes, start' (the build request is intercepted)",
  "start": "/",
  "turns": [
   {
    "say": "Build me a small app that keeps track of everything in my home, with a paid pro version that uses Stripe.",
    "via": "live",
    "expect": {
     "lane": "act/type",
     "fields": {
      "What do you want to build": "keeps track of everything in my home"
     },
     "no_writes": true
    }
   },
   {
    "say": "use the cheapest preset",
    "via": "live",
    "expect": {
     "fields": {
      "css:[data-preset=cheapest]": "true"
     },
     "no_writes": true
    }
   },
   {
    "say": "yes, build it",
    "via": "live",
    "expect": {
     "nav": "/build\\?step=brief",
     "answer_has": "This will start .* Start\\?",
     "no_writes": true
    }
   },
   {
    "say": "call it home things 2",
    "via": "live",
    "expect": {
     "fields": {
      "css:#pname": "^home-things-2$"
     },
     "offer": "Start building home-things-2\\?",
     "no_writes": true
    }
   },
   {
    "say": "yes, start",
    "via": "live",
    "expect": {
     "writes": "POST /api/build"
    }
   }
  ]
 },
 {
  "id": "voice-build-no",
  "title": "The brief's start question: 'no' never starts",
  "start": "/",
  "turns": [
   {
    "say": "Build me a small habit tracker",
    "via": "live",
    "expect": {
     "no_writes": true
    }
   },
   {
    "say": "yes, build it",
    "via": "live",
    "expect": {
     "nav": "/build\\?step=brief",
     "answer_has": "Start\\?",
     "no_writes": true
    }
   },
   {
    "say": "no",
    "via": "live",
    "expect": {
     "no_writes": true
    }
   }
  ]
 },
 {
  "id": "voice-fleet-start",
  "title": "Fleet job by voice: the form fills, Talk asks with the estimate and the hard cap, 'yes, start' presses Start (intercepted)",
  "start": "/runs",
  "turns": [
   {
    "say": "Document every exported function in VS Code with a thousand agents",
    "via": "live",
    "expect": {
     "fields": {
      "css:#nj-agents": "^1000$"
     },
     "answer_has": "This will start 1,000 agents.*stops at.*Start\\?",
     "no_writes": true
    }
   },
   {
    "say": "yes, start",
    "via": "live",
    "expect": {
     "writes": "POST /api/runs/start"
    }
   }
  ]
 },
 {
  "id": "voice-fleet-no",
