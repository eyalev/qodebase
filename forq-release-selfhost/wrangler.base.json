{
 "name": "my-qodebase",
 "main": "worker/index.js",
 "compatibility_date": "2026-10-01",
 "compatibility_flags": [
  "nodejs_compat"
 ],
 "observability": {
  "enabled": true
 },
 "workers_dev": true,
 "assets": {
  "directory": "./public"
 },
 "containers": [
  {
   "class_name": "BuildBox",
   "scheduling_policy": "durable_object"
  },
  {
   "class_name": "AgentBox",
   "scheduling_policy": "durable_object"
  }
 ],
 "durable_objects": {
  "bindings": [
   {
    "name": "AgentBox",
    "class_name": "AgentBox"
   },
   {
    "name": "Project",
    "class_name": "Project"
   },
   {
    "name": "Registry",
    "class_name": "Registry"
   },
   {
    "name": "BuildBox",
    "class_name": "BuildBox"
   },
   {
    "name": "Installs",
    "class_name": "Installs"
   },
   {
    "name": "TalkLog",
    "class_name": "TalkLog"
   },
   {
    "name": "TalkVoice",
    "class_name": "TalkVoice"
   },
   {
    "name": "Ledger",
    "class_name": "Ledger"
   }
  ]
 },
 "migrations": [
  {
   "tag": "v1",
   "new_sqlite_classes": [
    "AgentBox",
    "Project"
   ]
  },
  {
   "tag": "v2",
   "new_sqlite_classes": [
    "Registry"
   ]
  },
  {
   "tag": "v3",
   "new_sqlite_classes": [
    "BuildBox"
   ]
  },
  {
   "tag": "v4",
   "new_sqlite_classes": [
    "Installs"
   ]
  },
  {
   "tag": "v5",
   "new_sqlite_classes": [
    "TalkLog"
   ]
  },
  {
   "tag": "v6",
   "new_sqlite_classes": [
    "Ledger"
   ]
  },
  {
   "tag": "v7",
   "new_sqlite_classes": [
    "TalkVoice"
   ]
  }
 ],
 "rules": [
  {
   "type": "Data",
   "globs": [
    "**/*.tgz"
   ],
   "fallthrough": false
  },
  {
   "type": "Text",
   "globs": [
    "**/*.rev",
    "**/*-qb.mjs",
    "**/*-box-api.mjs",
    "**/*-boot.sh"
   ],
   "fallthrough": false
  }
 ],
 "artifacts": [
  {
   "binding": "ARTIFACTS",
   "namespace": "qodebase"
  }
 ],
 "version_metadata": {
  "binding": "CF_VERSION_METADATA"
 },
 "ai": {
  "binding": "AI"
 },
 "vars": {
  "SELF_HOST": "1",
  "BOX_IMAGE": "managed",
  "UI_HOST": "set-by-installer",
  "RUN_HOST": "set-by-installer",
  "API_BASE": "set-by-installer",
  "OWNER_HANDLE": "set-by-installer",
  "HANDLES": "{}",
  "CF_OAUTH_CLIENT_ID": "",
  "MAX_AGENTS_PER_PROJECT": "6",
  "OTHERS_MAX_AWAKE": "2",
  "MAX_AWAKE_BOXES": "3",
  "MAX_TOTAL_AWAKE": "6"
 },
 "no_bundle": true,
 "find_additional_modules": true,
 "base_dir": "worker"
}