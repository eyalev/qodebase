{
  // forq v0: one Worker. Project DOs hold a repo + its agents; each agent is an
  // AgentBox container DO (box/Dockerfile image) working on its own
  // Artifacts fork. See CLAUDE.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forq",
  "account_id": "887d7234a6b8d65ad355a4f6684cab67",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // forq's own Cloudflare account (since 2026-10-02; docs/hosting-plan.md).
  // Deploy with its token: CLOUDFLARE_API_TOKEN=$(cat <forq api-token file>).
  // workers.dev answers only with the admin secret (laptop scripts); the phone
  // uses projectsbase.dev, sign-in through Cloudflare Access on /login.
  "workers_dev": true,
  // Static files under /_forq/ (home page thumbnails, 2026-10-04). Assets answer on
  // every host this Worker serves, app hosts included, hence the unlikely prefix;
  // anything that is not a file here goes to the Worker as before.
  "assets": { "directory": "./public" },
  "routes": [
    { "pattern": "projectsbase.dev", "custom_domain": true },
    // Public run host: every repo and agent fork as a live static app (src/run.ts).
    { "pattern": "ttyview.dev", "custom_domain": true },
    // Every static project and fork on its own host: <name>--<owner>.ttyview.dev
    // (src/run.ts). Worker apps' hosts are excluded by routes with no Worker.
    { "pattern": "*.ttyview.dev/*", "zone_name": "ttyview.dev" }
  ],
  "containers": [
    {
      // forq's builder for Worker projects (src/build.ts): same image, no Claude Code.
      "class_name": "BuildBox",
      "scheduling_policy": "durable_object",
      "images": {
        "computer": { "image": "registry.cloudflare.com/887d7234a6b8d65ad355a4f6684cab67/forq-box@sha256:cdc40854e171b65865c695c590296aa4e3f1a47c272c7bbbef014827e6b67ccd" }
      }
    },
    {
      // The merger box (src/landing/merger.ts): lands merge-queue trains with real git.
      // Same image as the builder (git + Node); idle-stopped after 5 minutes.
      "class_name": "MergeBox",
      "scheduling_policy": "durable_object",
      "images": {
        "computer": { "image": "registry.cloudflare.com/887d7234a6b8d65ad355a4f6684cab67/forq-box@sha256:cdc40854e171b65865c695c590296aa4e3f1a47c272c7bbbef014827e6b67ccd" }
      }
    },
    {
      "class_name": "AgentBox",
      "scheduling_policy": "durable_object",
      "images": {
        // box/Dockerfile built and pushed once (wrangler containers build box
        // -t forq-box:vN -p), pinned by digest so a deploy never re-pushes 1.4 GB.
        "computer": { "image": "registry.cloudflare.com/887d7234a6b8d65ad355a4f6684cab67/forq-box@sha256:cdc40854e171b65865c695c590296aa4e3f1a47c272c7bbbef014827e6b67ccd" }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AgentBox", "class_name": "AgentBox" },
      { "name": "Project", "class_name": "Project" },
      { "name": "Registry", "class_name": "Registry" },
      { "name": "BuildBox", "class_name": "BuildBox" },
      { "name": "Installs", "class_name": "Installs" },
      { "name": "TalkLog", "class_name": "TalkLog" },
      { "name": "TalkVoice", "class_name": "TalkVoice" },
      { "name": "Ledger", "class_name": "Ledger" },
      // Landing system (src/landing/): records + merge queue per project, the merger box,
      // scripted demo agents (no model, no container).
      { "name": "Landing", "class_name": "Landing" },
      { "name": "MergeBox", "class_name": "MergeBox" },
      { "name": "DemoAgent", "class_name": "DemoAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AgentBox", "Project"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] },
    { "tag": "v3", "new_sqlite_classes": ["BuildBox"] },
    { "tag": "v4", "new_sqlite_classes": ["Installs"] },
    { "tag": "v5", "new_sqlite_classes": ["TalkLog"] },
    { "tag": "v6", "new_sqlite_classes": ["Ledger"] },
    { "tag": "v7", "new_sqlite_classes": ["TalkVoice"] },
    { "tag": "v8", "new_sqlite_classes": ["Landing", "MergeBox", "DemoAgent"] }
  ],
  // box/mobile-agent.tgz (scripts/pack-mobile-agent.sh) is bundled as bytes and
  // served to agent boxes at boot; box/mobile-agent.rev as text.
  "rules": [
    { "type": "Data", "globs": ["**/*.tgz"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.rev"], "fallthrough": true },
    // cli/qb.mjs is served as text at /cli/qb.mjs (src/cliauth.ts), never run here.
    { "type": "Text", "globs": ["**/qb.mjs"], "fallthrough": true },
    // box/boot.sh and box/box-api.mjs, written into managed boxes by box.ts #setup.
    { "type": "Text", "globs": ["**/boot.sh", "**/box-api.mjs"], "fallthrough": true },
    // src/landing/mergejob.mjs, written into the merger box and run there with node.
    { "type": "Text", "globs": ["**/mergejob.mjs"], "fallthrough": true }
  ],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "forq" }],
  // Images the person attaches to a request (src/attach.ts); lifecycle rule expire-30d deletes them after 30 days.
  "r2_buckets": [{ "binding": "ATTACH", "bucket_name": "qodebase-attachments" }, { "binding": "VIDEO", "bucket_name": "qodebase-video" }],
  // Artifacts events: pushes to project mains + project repo lifecycle (src/events.ts). Queues bills 3 ops per message.
  "queues": { "consumers": [{ "queue": "forq-artifacts-events", "max_batch_size": 25, "max_batch_timeout": 2, "max_retries": 3 }] },
  // Cloudflare Browser Rendering: App view screenshots (src/screenshot.ts); 10 browser-hours/month included, then $0.09/h.
  "browser": { "binding": "BROWSER" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "ai": { "binding": "AI" },
  "services": [{ "binding": "TALK", "service": "qodebase-talk" }, { "binding": "FLEET", "service": "qbfleet" }],
  "vars": {
    "TALK_GATEWAY": "qodebase-talk",
    // "Sign in with Cloudflare" (src/install.ts); secret CF_OAUTH_CLIENT_SECRET.
    "CF_OAUTH_CLIENT_ID": "c7a959b3f19f0ba8cabb1f7efb55d809",
    "ACCESS_TEAM_DOMAIN": "forqdev.cloudflareaccess.com",
    "ACCESS_AUD": "6c86f18e31312db3a76b73caf12f86a9ee360a75a667bb961608e55c9fea251e",
    // Access email → handle: the real map is the secret HANDLES_SECRET (wrangler secret put HANDLES_SECRET), kept out of git.
    "HANDLES": "{}",
    "UI_HOST": "projectsbase.dev",
    // Served by the front Worker in the personal account until the zone moves here (front/).
    "FRONT_HOSTS": "qodebase.app",
    // Design-variant preview Workers (variants/), 2026-10-02.
    "UI_VARIANT_HOSTS": "a.projectsbase.dev,b.projectsbase.dev,c.projectsbase.dev,d.projectsbase.dev",
    "RUN_HOST": "ttyview.dev",
    // Worker apps: <name>--<owner>.ttyview.dev, previews <alias>.<that host> (src/build.ts).
    "APPS_DOMAIN": "ttyview.dev",
    "APPS_ZONE_ID": "784f54acf330324763b9749cc76bc871",
    "ACCOUNT_ID": "887d7234a6b8d65ad355a4f6684cab67",
    // Artifacts events (src/events.ts): queue forq-artifacts-events; token CF_EVENTS_TOKEN is a secret (Queues Write).
    "EVENTS_QUEUE_ID": "4ca6198cc6294a66b450926aea09dbcd",
    "API_BASE": "https://forq.forqdev.workers.dev",
    // Hard caps (the durable_object policy has no max_instances).
    "MAX_AGENTS_PER_PROJECT": "6",
    // Build settings (Adjust on Build, src/buildsettings.ts): off | owner | all. "all" only after the Oct 14 checks.
    "BUILD_SETTINGS": "owner",
    // Runs on the Claude subscription; everyone else brings an Anthropic API key.
    "OWNER_HANDLE": "eyal",
    // Awake boxes per other user (their containers bill this account).
    "OTHERS_MAX_AWAKE": "2",
    "MAX_AWAKE_BOXES": "5",
    // Every awake box on the account, every role, owner included: a ceiling on
    // what the containers can bill at once (~$0.027/h per 3 GiB box).
    // Real builds R4/R5 raised these for their runs (30/24, then 50/40); back to normal after R5, 2026-10-13.
    "MAX_TOTAL_AWAKE": "20",
    "OWNER_MAX_CODERS": "20"
  }
  // Secrets: CLAUDE_CODE_OAUTH_TOKEN (Eyal's subscription), ADMIN_SECRET,
  // CF_DEPLOY_TOKEN (Workers Scripts write; only BuildBox uses it), ISSUES_WEBHOOK_SECRET,
  // OBS_READ_TOKEN (Workers Observability read), KEY_ENC_SECRET (users' API keys, AES-GCM).
}
